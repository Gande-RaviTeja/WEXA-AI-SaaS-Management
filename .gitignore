# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables (NEVER commit secrets to git)
.env
.env*.local
.env.production
.env.development
.env.test
!.env.example

# SQLite databases & journals (NEVER commit dev/prod databases)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db
prisma/*.db-journal
dev.db

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel & Editor directories
.vercel
.idea
.vscode/*
!.vscode/extensions.json

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
