# PostgreSQL connection string (Neon or standard PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Test Database URL (dedicated branch for test suite to protect demo data)
TEST_DATABASE_URL="postgresql://user:password@ep-sample-test-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Session encryption secret (minimum 32 characters)
SESSION_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"

# Optional: Application URL for production redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"
